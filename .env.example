PORT=4000

# SMTP settings for real email delivery.
# If left unset, the app falls back to printing the verification code to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EverythingByAda <no-reply@everythingbyada.com>"

# Optional: override the frontend default API base if needed.
# VITE_API_URL=http://localhost:4000
